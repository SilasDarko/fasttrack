# Copy to .env and adjust. Defaults require no external network access.

# postgresql+asyncpg://user:password@host:port/dbname
# Port 5433 (not 5432) is used on the host side to avoid clashing with any
# other local Postgres; docker-compose.yml maps it to 5432 inside the network.
DATABASE_URL=postgresql+asyncpg://fasttrack:fasttrack@localhost:5433/fasttrack

# "deterministic" (default, no network/API key) or "openai"
EMBEDDING_PROVIDER=deterministic
LLM_PROVIDER=deterministic

# Only required when EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=

# Model names used only by the OpenAI providers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Agent loop bound (tool calls + 1 finalize step)
AGENT_MAX_ITERATIONS=6

# Days after which a runbook is considered stale
RUNBOOK_STALE_DAYS=180
