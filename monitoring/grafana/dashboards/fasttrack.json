{
  "title": "FastTrack",
  "uid": "fasttrack-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API request rate by path",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool execution duration p95 by tool",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tool_execution_duration_seconds_bucket[5m])) by (le, tool_name))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool failure rate by tool / error_code",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(tool_execution_failures_total[5m])) by (tool_name, error_code)",
          "legendFormat": "{{tool_name}} / {{error_code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "pgvector retrieval latency p95 by evidence type",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(retrieval_duration_seconds_bucket[5m])) by (le, evidence_type))",
          "legendFormat": "{{evidence_type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingestion throughput by record type",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ingestion_records_total[5m])) by (record_type)",
          "legendFormat": "{{record_type}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Investigations by status",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(investigations_total) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM call latency p95 and error rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_call_duration_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "p95 latency ({{provider}})"
        },
        {
          "expr": "sum(rate(llm_calls_total{status=\"error\"}[5m])) by (provider)",
          "legendFormat": "errors/s ({{provider}})"
        }
      ]
    }
  ]
}
